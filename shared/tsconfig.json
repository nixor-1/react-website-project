{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    /* This allows the .js extensions in your .ts files */
    "allowJs": true,
    /* Essential for workspace packages */
    "composite": true, 
    "declaration": true,
    "declarationMap": true,
    /* Strictness */
    "strict": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "."
  },
  "include": ["**/*.ts"]
}
